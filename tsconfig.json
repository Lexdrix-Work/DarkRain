{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "electron.vite.config.ts"]
}
