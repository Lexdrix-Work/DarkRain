{
  "name": "dark-rain",
  "version": "0.0.1",
  "description": "A S.T.A.L.K.E.R.-style FPS survival horror game built with Three.js",
  "author": "Lexdrix",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "app": "vite build && electron .",
    "app:dev": "node scripts/electron-dev.cjs",
    "build": "vite build",
    "dev": "vite",
    "dist": "vite build && electron-builder",
    "dist:dir": "vite build && electron-builder --dir",
    "postinstall": "node scripts/setup.cjs",
    "preview": "vite preview",
    "setup": "node scripts/setup.cjs",
    "start": "vite build && electron ."
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.lexdrix.darkrain",
    "productName": "Dark Rain",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Dark Rain"
    },
    "portable": {
      "artifactName": "DarkRain-Portable-${version}.${ext}"
    }
  }
}
