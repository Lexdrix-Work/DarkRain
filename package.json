{
  "name": "dark-rain",
  "version": "0.0.1",
  "description": "A S.T.A.L.K.E.R.-style FPS survival horror game built with Three.js",
  "author": "Lexdrix",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "app": "electron-vite build && electron-vite preview",
    "app:dev": "electron-vite dev",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "postinstall": "node scripts/setup.cjs",
    "preview": "electron-vite preview",
    "setup": "node scripts/setup.cjs",
    "start": "electron-vite build && electron-vite preview",
    "test": "node --test tests/*.test.js",
    "dev:browser": "vite",
    "check": "tsc --noEmit",
    "clean": "node scripts/clean.cjs",
    "perf": "electron-vite dev -- --perf",
    "preview:browser": "vite preview --outDir out/renderer",
    "compile:structures": "node scripts/compile-structures.ts",
    "verify:stages": "electron-vite build && electron scripts/verify-game-stages.cjs",
    "test:perf": "electron scripts/verify-performance.cjs",
    "test:perf:software": "electron scripts/verify-performance.cjs --software",
    "profile:stress": "electron scripts/profile-stress.cjs --darkrain-memory-recovered",
    "verify:city-destruction": "electron scripts/verify-city-destruction.cjs --darkrain-memory-recovered",
    "verify:fx": "electron scripts/verify-fx.cjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "electron": "44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.lexdrix.darkrain",
    "productName": "Dark Rain",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Dark Rain"
    },
    "portable": {
      "artifactName": "DarkRain-Portable-${version}.${ext}"
    }
  },
  "overrides": {
    "rimraf": "^6.1.3",
    "glob": "^13.0.6"
  }
}
